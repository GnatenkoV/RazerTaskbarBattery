<UserControl x:Class="RazerTaskbar.UI.Views.DebugBatterySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RazerTaskbar.UI.Controls"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="RuleSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" Height="18" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" VerticalAlignment="Center" Background="{DynamicResource CaptureProtectorAccentHoverBrush}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource CaptureProtectorAccentHoverBrush}" CornerRadius="7">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.3"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" VerticalAlignment="Center" Background="{DynamicResource CaptureProtectorBorderBrush}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource SettingCardStyle}">
        <StackPanel>
            <TextBlock Text="Debug battery preview" FontSize="14" FontWeight="SemiBold" Style="{StaticResource FieldLabelStyle}"/>
            <TextBlock Text="Preview the tray icon without changing device readings. Debug builds only."
                       Style="{StaticResource FieldDescriptionStyle}" Margin="0,3,0,10"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Override displayed battery" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Text="Use the slider value for the tray icon." Style="{StaticResource FieldDescriptionStyle}"/>
                </StackPanel>
                <controls:AnimatedToggleSwitch x:Name="OverrideToggle" Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ApplicationToggleSwitchStyle}"
                                                Checked="OverrideChanged" Unchecked="OverrideChanged"/>
            </Grid>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=OverrideToggle}" Value="True">
                                <Setter Property="IsEnabled" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Battery level" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Text="0–100, including empty and full states." Style="{StaticResource FieldDescriptionStyle}"/>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="BatteryLevelSlider" Grid.Column="0" Minimum="0" Maximum="100"
                            TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                            VerticalAlignment="Center" Style="{StaticResource RuleSliderStyle}"
                            ValueChanged="LevelChanged"/>
                    <TextBlock x:Name="LevelLabel" Grid.Column="1" Text="50" TextAlignment="Right"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource CaptureProtectorTextBrush}"/>
                </Grid>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
