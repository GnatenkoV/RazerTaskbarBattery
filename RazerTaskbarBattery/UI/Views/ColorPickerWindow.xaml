<Window x:Class="RazerTaskbar.UI.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:RazerTaskbar.UI.Controls"
        Width="490" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ShowInTaskbar="False" FontFamily="Segoe UI"
        Background="{DynamicResource CaptureProtectorPanelBrush}" Foreground="{DynamicResource CaptureProtectorTextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ColorInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource CaptureProtectorTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource CaptureProtectorTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" CornerRadius="6" BorderThickness="1" Padding="3,0"
                                Background="{DynamicResource CaptureProtectorComboBoxBrush}"
                                BorderBrush="{DynamicResource CaptureProtectorComboBoxBorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource CaptureProtectorAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderThickness="1" BorderBrush="{DynamicResource CaptureProtectorBorderBrush}">
        <StackPanel>
            <controls:WindowHeader/>
            <StackPanel Margin="20">
                <TextBlock x:Name="PickerTitle" FontSize="17" FontWeight="SemiBold"/>
                <Grid Margin="0,16,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ColorPlane" Height="260" ClipToBounds="True" Cursor="Cross"
                          MouseLeftButtonDown="StartColorDrag" MouseMove="DragColor" MouseLeftButtonUp="EndColorDrag" SizeChanged="ColorPlaneSizeChanged">
                        <Rectangle x:Name="HueBase"/>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="Marker" Width="12" Height="12" Stroke="White" StrokeThickness="2" Fill="Transparent"/>
                        </Canvas>
                    </Grid>
                    <Slider x:Name="HueSlider" Grid.Column="1" Margin="12,0,4,0" Maximum="360" Orientation="Vertical"
                            IsDirectionReversed="True" IsMoveToPointEnabled="True" ValueChanged="HueChanged"
                            AutomationProperties.Name="Hue">
                        <Slider.Template>
                            <ControlTemplate TargetType="Slider">
                                <Grid>
                                    <Border Margin="3,5" CornerRadius="4">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF0000" Offset="0"/>
                                                <GradientStop Color="#FFFF00" Offset="0.167"/>
                                                <GradientStop Color="#00FF00" Offset="0.333"/>
                                                <GradientStop Color="#00FFFF" Offset="0.5"/>
                                                <GradientStop Color="#0000FF" Offset="0.667"/>
                                                <GradientStop Color="#FF00FF" Offset="0.833"/>
                                                <GradientStop Color="#FF0000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Height="14" Width="14" Cursor="Hand">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Ellipse Fill="{DynamicResource CaptureProtectorTextBrush}"
                                                                 Stroke="{DynamicResource CaptureProtectorAccentBrush}" StrokeThickness="1"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                        <Border Width="62" Height="62" CornerRadius="5" Padding="5" BorderThickness="1"
                                Background="{DynamicResource CaptureProtectorWindowBrush}"
                                BorderBrush="{DynamicResource CaptureProtectorBorderBrush}">
                            <Grid Background="{DynamicResource TransparencyCheckerBrush}">
                                <Rectangle x:Name="ColorSample"/>
                            </Grid>
                        </Border>
                        <DockPanel Margin="0,10,0,0">
                            <controls:AnimatedToggleSwitch x:Name="TransparentToggle" DockPanel.Dock="Right"
                                                           Style="{StaticResource ApplicationToggleSwitchStyle}"
                                                           Checked="TransparencyChanged" Unchecked="TransparencyChanged"
                                                           AutomationProperties.Name="Transparent color"/>
                            <TextBlock Text="Transparent" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        </DockPanel>
                        <TextBlock Text="Hex" Margin="0,14,0,4" Foreground="{DynamicResource CaptureProtectorMutedBrush}"/>
                        <TextBox x:Name="HexInput" Style="{StaticResource ColorInputStyle}" TextChanged="HexChanged" AutomationProperties.Name="Hex color"/>
                        <TextBlock Text="RGB" Margin="0,10,0,4" Foreground="{DynamicResource CaptureProtectorMutedBrush}"/>
                        <UniformGrid Columns="3">
                            <TextBox x:Name="RedInput" Margin="0,0,3,0" TextAlignment="Center" Style="{StaticResource ColorInputStyle}" TextChanged="RgbChanged" AutomationProperties.Name="Red"/>
                            <TextBox x:Name="GreenInput" Margin="1,0" TextAlignment="Center" Style="{StaticResource ColorInputStyle}" TextChanged="RgbChanged" AutomationProperties.Name="Green"/>
                            <TextBox x:Name="BlueInput" Margin="3,0,0,0" TextAlignment="Center" Style="{StaticResource ColorInputStyle}" TextChanged="RgbChanged" AutomationProperties.Name="Blue"/>
                        </UniformGrid>
                        <TextBlock x:Name="InputError" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="10"
                                   Foreground="{DynamicResource CaptureProtectorRedBrush}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button x:Name="ApplyButton" Content="Select color" IsDefault="True" Click="SelectColor" Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
