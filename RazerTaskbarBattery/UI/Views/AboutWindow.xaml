<Window x:Class="RazerTaskbar.UI.Views.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:controls="clr-namespace:RazerTaskbar.UI.Controls" Icon="/Assets/App.ico" Title="Razer Taskbar Battery — About" Width="570" Height="408" MinWidth="500" MinHeight="360" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="{DynamicResource CaptureProtectorWindowBrush}" Foreground="{DynamicResource CaptureProtectorTextBrush}" FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource CaptureProtectorWindowBrush}" BorderBrush="{DynamicResource CaptureProtectorBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>
            <controls:WindowHeader Grid.Row="0"/>
            <Border Grid.Row="1" Background="{DynamicResource CaptureProtectorSidebarBrush}" BorderBrush="{DynamicResource CaptureProtectorBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Margin="21,12,20,9">
                    <TextBlock Text="About" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="RAZER TASKBAR BATTERY" Foreground="{DynamicResource CaptureProtectorMutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Margin="20,15" Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <TextBlock Text="Razer Taskbar Battery" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="19" FontSize="12" Text="A lightweight Windows notification-area battery monitor for compatible Razer devices. Reads battery levels through Windows HID interfaces with optional Synapse log fallback." Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Author" Foreground="{DynamicResource CaptureProtectorMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="Vitaliy Hnatenko"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Version" Foreground="{DynamicResource CaptureProtectorMutedBrush}"/>
                        <TextBlock x:Name="VersionText" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SOURCE REPOSITORY" Foreground="{DynamicResource CaptureProtectorMutedBrush}" FontSize="10" Margin="0,1,0,5"/>
                        <TextBlock Grid.Column="1"><Hyperlink x:Name="RepoLink" Click="OpenRepository" Foreground="{DynamicResource CaptureProtectorAccentBrush}">github.com/GnatenkoV/RazerTaskbarBattery</Hyperlink></TextBlock>
                    </Grid>
                    
                </StackPanel>
            </Border>
            <Border Grid.Row="3" Background="{DynamicResource CaptureProtectorSidebarBrush}" BorderBrush="{DynamicResource CaptureProtectorBorderBrush}" BorderThickness="0,1,0,0">
                <Button Content="Close" Width="100" Height="36" Margin="0,11,20,11" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="CloseWindow" IsCancel="True"/>
            </Border>
        </Grid>
    </Border>
</Window>
